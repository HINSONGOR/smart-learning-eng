# 複製為 .env.local 後填寫。全部留空 = 本機版（資料存放在 data/ 資料夾，不需要登入）。

# 雲端版：使用 Firebase Firestore 及名字 + PIN 登入
# DATA_BACKEND=firestore
# AUTH_MODE=firebase

# Firebase 伺服器金鑰（二選一）
# 本機：金鑰檔路徑（請放在專案資料夾以外）
# FIREBASE_SERVICE_ACCOUNT_PATH='C:/path/to/firebase-adminsdk.json'
# Vercel：把金鑰檔的完整內容貼上
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# 學習者對應的 Firebase 帳戶電郵（格式：學習者ID=電郵，以逗號分隔）
# LEARNER_ACCOUNTS=me=you@example.com,son=son@example.com

# Firebase 網頁設定（Project settings → Your apps）
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# 可選：Gemini 查字
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite